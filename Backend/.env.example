PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kalpana
# One or more website origins allowed by CORS and the admin CSRF check, comma-separated.
CLIENT_ORIGIN=http://localhost:5173
# Required (>= 32 random chars) when NODE_ENV=production; signs admin session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SECRET=
# Where uploaded images are stored (default: Backend/uploads). Back this folder up with the database.
UPLOAD_DIR=
NODE_ENV=development
# Behind a reverse proxy (nginx, Render, ...) set to the number of proxies, e.g. 1, so rate limits use the real client ip.
#TRUST_PROXY=1
# Public POST throttles per ip (0 = off) and the unpaid-order cap per e-mail/ip.
ORDER_RATE_LIMIT=10
ENQUIRY_RATE_LIMIT=10
RATE_LIMIT_WINDOW_MINUTES=60
MAX_PENDING_ORDERS=3
# Set to "memory" to keep rate-limit counters per process instead of in MongoDB.
#RATE_LIMIT_STORE=memory
# How often unpaid orders older than the holdHours setting (admin settings, default 48h) are auto-cancelled.
HOLD_SWEEP_MINUTES=10
